PADDLEOCR_LANG=en
PADDLEOCR_USE_GPU=false
OCR_MIN_TEXT_CONFIDENCE=0.45
OCR_MIN_COMPONENT_AREA=180
FAST_OCR_MAX_EDGE=1280

# Fast P&ID analysis (/analyze_fast)
FAST_ANALYSIS_TIMEOUT_SECONDS=150

# Ollama — required for LLM-verified counts
OLLAMA_ENABLED=true
OLLAMA_USE_FOR_COUNTS=true
OLLAMA_TRUST_COUNTS=true
DISABLE_OLLAMA_VERIFICATION=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=phi3-mini
OLLAMA_FAST_TIMEOUT_SECONDS=8
OLLAMA_COMPLETION_TIMEOUT_SECONDS=12
OLLAMA_TIMEOUT_SECONDS=20

# Component library (upload reference photos at start)
COMPONENT_LIBRARY_AUTO_TRAIN=true
TEMPLATE_MAX_PER_CATEGORY=6

ML_COUNT_MIN_CONFIDENCE=0.50

# Template matching fast caps (used by /analyze_fast)
FAST_TEMPLATE_MATCH_TIMEOUT_SECONDS=10
FAST_TEMPLATE_MAX_PER_CATEGORY=25
FAST_TEMPLATE_MAX_TOTAL=60
FAST_MATCH_RELEVANT_ONLY=true
FAST_DISABLE_ORB_OVER_TEMPLATE_COUNT=0
FAST_OLLAMA_WAIT_CAP_SECONDS=8
FAST_ACCURACY_PRIORITIZE_OLLAMA=true
FAST_OLLAMA_TEXT_CHARS=2200
